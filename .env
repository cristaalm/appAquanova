# ====================
# Configuración de conexión
# ====================
SERIAL_PORT=COM5
BAUD_RATE=9600

# ====================
# Rutas de recursos
# ====================
ICONS=resources/icons/
MEDIA=resources/media/

# ====================
# Sombra (en formato RGB)
# ====================
SHADOW=197,239,236

# ====================
# Colores para la interfaz y gráficas
# ====================
# Fondo general
COLOR_C8F5F2=#C8F5F2

# Color de texto
COLOR_LEYEND=#045859

# Línea de temperatura del agua
WATER_TEMP_COLOR=#3C9A9B

# Línea de humedad ambiental
HUMIDITY_COLOR=#1E89CF

# Línea de temperatura ambiental
TEMP_COLOR=#E67E22

# Tamaño de los puntos en las gráficas
GRAPH_POINT_SIZE=7

# ====================
# Configuración general
# ====================
SISTEMA=1
URL=https://aquanovaweb.onrender.com
